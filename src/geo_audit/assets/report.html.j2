<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>GEO audit — {{ client.site }} — {{ client.generated_on }}</title>
<style>{{ stylesheet }}</style>
</head>
<body>

<header class="masthead">
  <div class="wrap">
    {% if client.brand.name or client.brand.logo %}
    <div class="brandline">
      {% if client.brand.logo %}<img src="{{ client.brand.logo }}" alt="{{ client.brand.name or 'Logo' }}">{% endif %}
      {% if client.brand.name %}<span class="who">{{ client.brand.name }}</span>{% endif %}
    </div>
    {% endif %}
    <h1>GEO audit: {{ client.site }}</h1>
    <p class="meta">{{ client.pages_scored }} page{{ '' if client.pages_scored == 1 else 's' }} scored &middot; {{ client.generated_on }}</p>
  </div>
</header>

<div class="wrap">

  {# 1 — the answer #}
  <section aria-labelledby="verdict-heading">
    <h2 id="verdict-heading" class="sr-only" style="position:absolute;left:-9999px">Result</h2>
    <div class="hero">
      <div class="verdict">
        <span class="score">{{ client.composite if client.composite is not none else '—' }}</span>
        <span class="outof">out of 100</span>
        {% if client.tier %}<span class="tier" data-tier="{{ client.tier | lower }}">{{ client.tier }}</span>{% endif %}
      </div>
      {% if client.composite is not none %}
      <div class="meter"{% if client.tier %} data-tier="{{ client.tier | lower }}"{% endif %} aria-hidden="true"><span style="width: {{ client.composite }}%"></span></div>
      {% endif %}
      {% if client.tier_meaning %}<p class="verdict-meaning">{{ client.tier_meaning }}</p>{% endif %}
      <div class="fineprint">
        {% if client.completeness_note %}<p class="caveat">{{ client.completeness_note }}</p>{% endif %}
        <p class="caveat">{{ client.score_caveat }}</p>
      </div>
    </div>

    {% if client.evidence_note %}
    <div class="note"><p>{{ client.evidence_note }}</p></div>
    {% endif %}

    {% if client.ordered_for %}
    <div class="note"><p>{{ client.ordered_for }}</p></div>
    {% endif %}

    {% if client.summary %}
    <h2>Summary</h2>
    <p class="summary">{{ client.summary }}</p>
    {% endif %}

    {% if client.strengths %}
    <h2>What is already working</h2>
    <ul class="ticks">
      {% for strength in client.strengths %}
      <li>{{ strength.text }}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if client.headlines %}
    <h2>What stands out</h2>
    <ul class="headlines">
      {% for fix in client.headlines %}
      <li><span class="pill {{ fix.severity }}">{{ fix.severity }}</span> <strong>{{ fix.title }}</strong> <span class="muted">affects {{ fix.page_count }} page{{ '' if fix.page_count == 1 else 's' }}</span></li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if client.top_fixes %}
    <h2>What to do, in order</h2>
    {% for fix in client.top_fixes %}
    <div class="fix {{ fix.severity }}">
      <h3>{{ loop.index }}. {{ fix.title }}</h3>
      <p class="tags">
        <span class="tag">{{ fix.severity }}</span>
        <span class="chip">{{ fix.effort }} effort</span>
        <span class="chip">{{ fix.page_count }} page{{ '' if fix.page_count == 1 else 's' }}</span>
        {% if fix.impact %}<span class="chip gain">up to +{{ '%g' % fix.impact }} overall</span>{% elif fix.points %}<span class="chip gain">up to {{ fix.points }} points in {{ fix.category }}</span>{% endif %}
      </p>
      <p>{{ fix.remediation }}</p>
      {% if fix.evidence or fix.excerpt %}
      <div class="evidence">
        {% for line in fix.evidence %}<p>{{ line }}</p>{% endfor %}
        {% if fix.excerpt %}<blockquote>{{ fix.excerpt }}</blockquote>{% endif %}
      </div>
      {% endif %}
      {% if fix.pages %}
      <p class="pages">{% for page in fix.pages[:3] %}<span class="path">{{ page | page_path(client.site) }}</span>{% endfor %}{% if fix.page_count > 3 %}<span class="more">and {{ fix.page_count - 3 }} more</span>{% endif %}</p>
      {% endif %}
    </div>
    {% endfor %}
    {% endif %}

    {% if client.plan %}
    <h2>The plan</h2>
    <p class="caveat">Every fix in this report, grouped by what it costs - low, medium and high
       effort - and kept in the order above within each group. Anything that stops a crawler
       reading the site is in the first group whatever it costs.</p>
    {% for group in client.plan %}
    <div class="plan-group">
      <h3>{{ group.name }} <span class="gain">{{ group.effort }} effort{% if group.gain %} &middot; up to +{{ '%g' % group.gain }} overall{% endif %}</span></h3>
      <ol class="plan">
        {% for fix in group.fixes %}
        <li><span>{{ fix.title }}</span>{% if fix.impact %} <span class="gain">+{{ '%g' % fix.impact }}</span>{% endif %}</li>
        {% endfor %}
      </ol>
    </div>
    {% endfor %}
    {% endif %}
  </section>

  {# 2 — category scores #}
  {% if client.categories %}
  <section>
    <h2>Category scores</h2>
    <table>
      <thead><tr><th>Category</th><th>Score</th><th>Rating</th><th>Weight</th><th>Adds</th><th>What it measures</th></tr></thead>
      <tbody>
      {% for category in client.categories %}
        <tr>
          <td class="label" data-label="Category">{{ category.name }}</td>
          <td class="num label" data-label="Score"><span class="val">{{ category.score }}/100</span><span class="bar" data-tier="{{ category.tier }}" aria-hidden="true"><span style="width: {{ category.score }}%"></span></span></td>
          <td class="label" data-label="Rating"><span class="tier-word" data-tier="{{ category.tier }}">{{ category.tier }}</span></td>
          <td class="num label" data-label="Weight">{{ category.weight if category.weight else '—' }}</td>
          <td class="num label" data-label="Adds">{{ category.contribution }}</td>
          <td class="label" data-label="Measures">{{ category.blurb }}</td>
        </tr>
      {% endfor %}
      </tbody>
      {% if client.composite is not none %}
      <tfoot>
        <tr>
          <td class="label" data-label="Category">Overall</td>
          <td class="num label" data-label="Score">{{ client.composite }}/100</td>
          <td class="label" data-label="Rating">{% if client.tier %}<span class="tier-word" data-tier="{{ client.tier | lower }}">{{ client.tier }}</span>{% endif %}</td>
          <td class="num label" data-label="Weight">{{ client.categories | map(attribute='weight') | select | sum }}</td>
          <td class="num label" data-label="Adds">{{ client.composite }}</td>
          <td class="label" data-label="Measures">Each category's score times its weight, over the total weight.</td>
        </tr>
      </tfoot>
      {% endif %}
    </table>
    {% if client.unscored %}
    <p class="caveat">{% for category in client.unscored %}{{ category.name }} (weight {{ category.weight }}){{ ', ' if not loop.last }}{% endfor %} {{ 'was' if client.unscored | length == 1 else 'were' }} not part of this run, so the overall score is taken over the categories that were.</p>
    {% endif %}
  </section>
  {% endif %}

  {# AI crawler access: who can reach the site, and what each refusal costs #}
  {% if client.crawlers %}
  <section>
    <h2>AI crawler access</h2>
    <p>Which AI crawlers robots.txt lets in. Blocking a search or answer crawler keeps the site
       out of that engine's answers; a training crawler is a separate decision.</p>
    <table>
      <thead><tr><th>Crawler</th><th>Operator</th><th>Used for</th><th>Access</th><th>What to do</th></tr></thead>
      <tbody>
      {% for row in client.crawlers %}
        <tr>
          <td class="label" data-label="Crawler">{{ row.token }}</td>
          <td class="label" data-label="Operator">{{ row.operator }}</td>
          <td class="label" data-label="Used for">{{ row.purpose }}</td>
          <td class="label access {{ 'allowed' if row.allowed else 'blocked' }}" data-label="Access"><span>{{ 'Allowed' if row.allowed else 'Blocked' }}</span></td>
          <td class="label{{ ' advice-none' if row.allowed }}" data-label="What to do">{{ row.advice }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# Category detail: every signal, by name #}
  {% if client.category_detail %}
  <section>
    <h2>Category detail</h2>
    {% for group in client.category_detail %}
    <h3 class="detail">{{ group.name }}{% if group.score is not none %} <span class="chip">{{ group.score }}/100</span>{% endif %}</h3>
    <table class="signals">
      <tbody>
      {% for signal in group.signals %}
        <tr>
          <td class="label" data-label="Measure">{{ signal.name }}</td>
          {% if signal.percent is not none %}
          <td class="num label" data-label="Score"><span class="val wide">{{ signal.value }} of {{ signal.max }}</span><span class="bar" aria-hidden="true"><span style="width: {{ signal.percent }}%"></span></span></td>
          {% else %}
          <td class="label status" data-label="Score">{{ signal.status }}{% if signal.note %}: {{ signal.note }}{% endif %}</td>
          {% endif %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endfor %}
  </section>
  {% endif %}

  {# 3 — findings by category #}
  {% if client.by_category %}
  <section>
    <h2>Everything found</h2>
    {% for category, fixes in client.by_category.items() %}
    <h3 class="group">{{ category }}</h3>
    {% for fix in fixes %}
    <div class="fix {{ fix.severity }}">
      <h3>{{ fix.title }}</h3>
      <p class="tags"><span class="tag">{{ fix.severity }}</span> <span class="chip">{{ fix.effort }} effort</span> <span class="chip">{{ fix.page_count }} page{{ '' if fix.page_count == 1 else 's' }}</span>{% if fix.impact %} <span class="chip gain">up to +{{ '%g' % fix.impact }} overall</span>{% endif %}</p>
      <p>{{ fix.remediation }}</p>
      {% if fix.evidence or fix.excerpt %}
      <div class="evidence">
        {% for line in fix.evidence %}<p>{{ line }}</p>{% endfor %}
        {% if fix.excerpt %}<blockquote>{{ fix.excerpt }}</blockquote>{% endif %}
      </div>
      {% endif %}
      {% if fix.pages %}<p class="pages">{% for page in fix.pages %}<span class="path">{{ page | page_path(client.site) }}</span>{% endfor %}</p>{% endif %}
    </div>
    {% endfor %}
    {% endfor %}
  </section>
  {% endif %}

  {# 4 — advisory, visually distinct and excluded from every number #}
  {% if client.advisory %}
  <section class="advisory">
    <span class="label">Advisory — model judgement, not scored</span>
    <h2>Advisory analysis</h2>
    <p>Nothing in this section contributes to any score above. It is included because
       it is useful, and separated because it is judgement rather than measurement.</p>
    {% for item in client.advisory %}
    <h3>{{ item.question }}</h3>
    {% if item.answered %}
    <p><strong>{{ item.verdict | capitalize }}.</strong> {{ item.note }}</p>
    {% else %}
    <p>Not assessed. This question is answered by a person or a model reading the
       page, and no answer was supplied for this report.</p>
    {% endif %}
    {% if item.rubric %}
    <p class="pages">Judged against: {{ item.rubric | join(' ') }}</p>
    {% endif %}
    {% endfor %}
  </section>
  {% endif %}

  {# 5 — appendix #}
  <section class="appendix">
    <h2>How this was measured</h2>
    <p>Every number above is computed by a program from a recorded snapshot of the
       site, not judged by a model. The same snapshot scored again produces the same
       number.</p>

    <h3>Categories and their weights</h3>
    <dl>
      {% for entry in client.methodology %}
      <dt>{{ entry.name }}{% if entry.weight %} — weight {{ entry.weight }}{% endif %}</dt>
      <dd>{{ entry.blurb }}</dd>
      {% endfor %}
    </dl>

    <h3>Signal classes</h3>
    <dl>
      {% for entry in client.signal_classes %}
      <dt>{{ entry.name }}</dt><dd>{{ entry.meaning }}</dd>
      {% endfor %}
    </dl>

    <h3>Comparability</h3>
    <p>A score is comparable with another score from this tool at the same scoring and
       data version. Numbers from other tools measure different things.</p>
  </section>

  {% if client.pages_analysed %}
  <section class="appendix">
    <h2>Pages analysed</h2>
    <table>
      <thead><tr><th>Page</th><th>Status</th><th>Findings</th></tr></thead>
      <tbody>
      {% for page in client.pages_analysed %}
        <tr>
          <td class="label" data-label="Page"><span class="path">{{ page.url | page_path(client.site) }}</span></td>
          <td class="num label" data-label="Status">{{ page.status if page.status else '—' }}{% if not page.read %} (not read){% endif %}</td>
          <td class="num label" data-label="Findings">{{ page.findings }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  <section class="appendix">
    <h2>Glossary</h2>
    <dl>
      {% for entry in client.glossary %}<dt>{{ entry.term }}</dt><dd>{{ entry.meaning }}</dd>{% endfor %}
    </dl>
  </section>

  {% block provenance %}{% endblock %}

  <footer class="colophon">
    <p>Evidence {{ client.evidence_stamp }} &middot; scoring {{ client.versions.scoring }} &middot;
       data {{ client.versions.data }} &middot; normalizer {{ client.versions.normalizer }}</p>
    {% if client.brand.attribution %}
    <p>Generated with {{ client.product_name }} {{ client.versions.tool }}.</p>
    {% endif %}
  </footer>

</div>
</body>
</html>
