      ],
      "points_lost": 5.0,
      "priority": 13,
      "remediation": "Add the specific figure, date, version or measurement to each claim, and link the primary source. Passages carrying a checkable fact are the ones engines quote.",
      "severity": "medium",
      "title": "Claims arrive without numbers, dates or sources"
    },
