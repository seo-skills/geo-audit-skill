      ],
      "points_lost": 6.0,
      "priority": 16,
      "remediation": "Advertise a sitemap in robots.txt and, if the site publishes regularly, link an RSS or Atom feed from the head. Both are how a crawler finds pages nothing links to yet.",
      "severity": "low",
