      ],
      "points_lost": 10.0,
      "priority": 15,
      "remediation": "Where the content fits, add FAQPage, HowTo, Product, Event or BreadcrumbList. These types map onto the shape of an answer, so an engine can lift them with no interpretation at all.",
      "severity": "low",
      "title": "No structured data that answers a question directly"
    },
